FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system/domain2";
    object fvSolution;
}
solvers
{
    p_rgh
    {
        solver GAMG;
        tolerance 1e-7;
        relTol 0.01;
        smoother DIC;
        maxIter 100;
    }
    "(U|h|e|k|epsilon)"
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-7;
        relTol 0.1;
    }
    G
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-5;
        relTol 0.1;
    }
    qr
    {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-5;
        relTol 0.1;
    }
}
SIMPLE
{
    nNonOrthogonalCorrectors 1;
    pRefCell 0;
    pRefValue       0.001;
    rhoMax 1e-4;
    rhoMin 1e-12;
}
relaxationFactors
{
    fields
    {
        rho   1;
        p_rgh 0.7;
    }
    equations
    {
        U       0.3;
        "(h|e)" 0.3;
        G       0.7;
        qr      0.7;
    }
}
