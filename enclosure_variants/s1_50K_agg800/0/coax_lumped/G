FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/coax_lumped";
    object      G;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 212.73;

boundaryField
{
    coldPlate
    {
        type            MarshakRadiation;
        T               T;
        emissivityMode  lookup;
        emissivity      uniform 0.02;
        value           uniform 212.73;
    }
    warmPlate
    {
        type            MarshakRadiation;
        T               T;
        emissivityMode  lookup;
        emissivity      uniform 0.04;
        value           uniform 212.73;
    }
    coax_lumped_to_domain2
    {
        type            calculated;
        value           uniform 0;
    }
}


