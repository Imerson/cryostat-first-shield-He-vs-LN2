FoamFile
{
    version 2.0;
    format ascii;
    class dictionary;
    location "system/domain0";
    object fvSchemes;
}
ddtSchemes
{
    default steadyState;
}
gradSchemes
{
    default Gauss linear;
}
divSchemes
{
    default none;
    div(phi,U) Gauss upwind;
    div(phi,h) Gauss upwind;
    div(phi,K) Gauss upwind;
    div(((rho*nuEff)*dev2(T(grad(U))))) Gauss linear;
    div(Ji,Ii_h) Gauss linearUpwind grad(Ii_h);
}
laplacianSchemes
{
    default Gauss linear corrected;
}
interpolationSchemes
{
    default linear;
}
snGradSchemes
{
    default corrected;
}
fluxRequired
{
    default no;
    p_rgh;
}
