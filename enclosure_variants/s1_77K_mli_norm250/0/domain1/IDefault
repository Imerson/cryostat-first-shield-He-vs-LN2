FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/domain1";
    object      IDefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    warmPlate
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.04;
        value           uniform 0;
    }
    shield_bottom
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.04;
        value           uniform 0;
    }
    shield
    {
        type            greyDiffusiveRadiation;
        emissivityMode  lookup;
        emissivity      uniform 0.02;
        value           uniform 0;
    }
    domain1_to_coax_L2
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L4
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L1
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L3
    {
        type            calculated;
        value           uniform 0;
    }

    coldPlate
    {
        type            calculated;
        value           uniform 0;
    }

}


