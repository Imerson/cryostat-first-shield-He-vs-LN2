FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/fluid";
    object      IDefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


dimensions      [1 0 -3 0 0 0 0];
internalField   uniform 5.3182e+01;

boundaryField
{
    coldPlate { type greyDiffusiveRadiation; emissivityMode lookup; emissivity uniform 0.02; value uniform 5.3182e+01; }
    warmPlate { type greyDiffusiveRadiation; emissivityMode lookup; emissivity uniform 0.04; value uniform 5.3182e+01; }
    farfield  { type greyDiffusiveRadiation; emissivityMode lookup; emissivity uniform 0.04; value uniform 5.3182e+01; }
    shield   { type greyDiffusiveRadiation; emissivityMode lookup; emissivity uniform 0.02; value uniform 5.3182e+01; }
}
