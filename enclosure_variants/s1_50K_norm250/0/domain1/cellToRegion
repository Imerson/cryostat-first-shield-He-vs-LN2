FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0/domain1";
    object      cellToRegion;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    warmPlate
    {
        type            zeroGradient;
    }
    OVC
    {
        type            zeroGradient;
    }
    shield
    {
        type            zeroGradient;
    }
    domain1_to_coax_L2
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L4
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L1
    {
        type            calculated;
        value           uniform 0;
    }
    domain1_to_coax_L3
    {
        type            calculated;
        value           uniform 0;
    }
}


