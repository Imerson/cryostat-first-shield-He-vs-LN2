@article{1-Optimaalcooling,
title = {Optimal cooling configurations for quantum information processing at milli-kelvin temperatures},
journal = {Cryogenics},
volume = {126},
pages = {103538},
year = {2022},
issn = {0011-2275},
doi = {https://doi.org/10.1016/j.cryogenics.2022.103538},
url = {https://www.sciencedirect.com/science/article/pii/S0011227522001205},
author = {T. Poole and T. Marsh and A.J. Matthews},
keywords = {Dilution refrigerator, Qubit, NISQ},
abstract = {So called quantum supremacy has been demonstrated by at least two groups utilising  < 100 physical superconducting qubits cooled to milli-kelvin temperatures. It is acknowledged that scaling these efforts to fault-tolerant, general purpose quantum computers will require very many more logical qubits, each formed from several physical ones. Addressing and control of these qubits is an area of active research, but it is likely that increased cooling capacities, particularly at the lowest temperatures, will be a requirement for the realisation of systems beyond noisy intermediate-scale quantum processors. Here we demonstrate a method by which significantly increased cooling power at temperatures ∼ 200 mK can be generated without impacting on the performance of an adjacent stage providing cooling power at temperatures ∼ 20 mK.}
}

