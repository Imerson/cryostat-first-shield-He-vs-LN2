FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system/fluid";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


solvers
{
    rho             { solver PCG;  preconditioner DIC; tolerance 1e-7; relTol 0.05; }
    p_rgh           { solver GAMG; smoother GaussSeidel; tolerance 1e-7; relTol 0.05; }
    "(U|h|e|k|epsilon)"
                    { solver PBiCGStab; preconditioner DILU; tolerance 1e-7; relTol 0.05; }
    G               { solver PBiCGStab; preconditioner DILU; tolerance 1e-5; relTol 0.1; }
    qr              { solver PBiCGStab; preconditioner DILU; tolerance 1e-5; relTol 0.1; }
    Ii_h            { solver PBiCGStab; preconditioner DILU; tolerance 1e-5; relTol 0.1; }
}
SIMPLE
{
    momentumPredictor       yes;
    nNonOrthogonalCorrectors 1;
    pRefCell  0;
    pRefValue 1.0;
    rhoMin   1e-9;
    rhoMax   10.0;
    residualControl
    {
        p_rgh   1e-4;
        U       1e-4;
        h       1e-3;
        G       1e-4;
        qr      1e-4;
    }
}
relaxationFactors
{
    fields    { rho 1.0; p_rgh 0.7; }
    equations { U 0.3; "(h|e)" 0.3; G 0.7; qr 0.7; }
}
