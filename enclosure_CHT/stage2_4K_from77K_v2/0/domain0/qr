FoamFile
{
    version     2.0;
    format      binary;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "1950/domain0";
    object      qr;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    OVC
    {
        type            greyDiffusiveRadiationViewFactor;
        value           uniform 0;
        qro             uniform 0;
    }
    shield_slave
    {
        type            greyDiffusiveRadiationViewFactor;
        value           uniform 0;
        qro             uniform 0;
    }
}


