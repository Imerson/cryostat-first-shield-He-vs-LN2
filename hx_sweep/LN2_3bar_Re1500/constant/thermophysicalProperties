FoamFile
{
    version         2;
    format          ascii;
    class           dictionary;
    object          thermophysicalProperties;
}

thermoType
{
    type            heRhoThermo;
    mixture         pureMixture;
    transport       const;
    thermo          hConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleEnthalpy;
}

mixture
{
    specie
    {
        molWeight       28;
    }
    equationOfState
    {
        rho             807;
    }
    thermodynamics
    {
        Cp              2042;
        Hf              0;
    }
    transport
    {
        mu              0.000161;
        Pr              2.36;
    }
}


