FoamFile
{
    version         2;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          T;
}

dimensions      [ 0 0 0 1 0 0 0 ];

internalField   uniform 50;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform 45;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 50;
        value           uniform 50;
    }
    heatedWall
    {
        type            fixedGradient;
        gradient uniform 13424.7358;
    }
    adiabaticWalls
    {
        type            zeroGradient;
    }
}


